# Copy to .env and fill in. .env is git-ignored; CI uses GitHub Actions secrets instead.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# OpenTofu state backend (R2 S3 API). Key id = API token id, secret = sha256(API token).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://<account-id>.r2.cloudflarestorage.com
TF_VAR_account_id=
